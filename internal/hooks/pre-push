#!/bin/sh
# pre-push：机器级机制闸（与分支无关；由 install.sh 安装到 ~/.dsh-gates/hooks/pre-push）
set -u
SCAN="$HOME/.dsh-gates/pre-push-scan.mjs"
if [ ! -f "$SCAN" ]; then
  echo "[gate] ✗ 无法判定：缺 $SCAN（fail-closed，拒绝推送）" >&2
  exit 1
fi
repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
exec node "$SCAN" --repo "$repo"
